#include <stdio.h>

int sumOfNatural(int n) {
    if(n == 0) 
        return 0;
    else
        return n + sumOfNatural(n - 1);
}

int main() {
    int n;

    printf("Enter a positive number: ");
    scanf("%d", &n);

    if(n < 0)
        printf("Please enter a positive number.\n");
    else
        printf("Sum of first %d natural numbers is %d\n", n, sumOfNatural(n));

    return 0;
}
